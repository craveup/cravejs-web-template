# Copy to .env.local and choose exactly one public runtime profile.
# .env.local is git-ignored. Profile JSON contains public storefront settings,
# not credentials, capabilities, customer sessions, or provider values.

# Shared public Storefront API origin. This must exactly match apiBaseUrl in
# every selected profile config; the SDK adds /api/v1/storefront.
NEXT_PUBLIC_CRAVEUP_API_URL=http://localhost:4708

# standalone-cli projects use one immutable generated config and never read a
# hosted registry. The external CLI generates projectId/tenantId and replaces
# these example origins before production deployment.
STOREFRONT_PROFILE=standalone-cli
STOREFRONT_STANDALONE_CONFIG_JSON={"profile":"standalone-cli","tenantId":"standalone:123e4567-e89b-42d3-a456-426614174000","projectId":"123e4567-e89b-42d3-a456-426614174000","merchantSlug":"replace-me","canonicalOrigin":"http://localhost:3000","apiBaseUrl":"http://localhost:4708","assetOrigins":[],"checkoutOrigins":["https://checkout.example.invalid"],"themeId":"base","locale":"en-US","timeZone":"America/Los_Angeles","templateRelease":"0.1.0","configSchemaVersion":"1.0.0","capabilities":{"loyalty":false},"newsletter":{"heading":"Stay in the loop","emailLabel":"Email address","submitLabel":"Subscribe","consentCopy":"Get restaurant news and offers in your inbox.","successMessage":"Thanks for subscribing."}}

# Hosted deployments instead set STOREFRONT_PROFILE=hosted-multitenant and a
# trusted server-only exact-host registry. Do not configure both profiles.
# STOREFRONT_HOSTED_TENANTS_JSON={"store.example.com":{"profile":"hosted-multitenant","tenantId":"tenant-replace-me","projectId":null,"merchantSlug":"replace-me","canonicalOrigin":"https://store.example.com","apiBaseUrl":"https://api.example.com","assetOrigins":[],"checkoutOrigins":["https://checkout.example.com"],"themeId":"base","locale":"en-US","timeZone":"America/Los_Angeles","templateRelease":"0.1.0","configSchemaVersion":"1.0.0","capabilities":{"loyalty":false},"newsletter":{"heading":"Stay in the loop","emailLabel":"Email address","submitLabel":"Subscribe","consentCopy":"Get restaurant news and offers in your inbox.","successMessage":"Thanks for subscribing."}}}

# Delivery address browser integration. Restrict the key by exact domain and
# only the Google Maps APIs used by the storefront.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-domain-restricted-browser-key

# Optional server-side storefront delivery-radius policy; defaults to 5 miles.
# STOREFRONT_DELIVERY_RADIUS_MILES=5

# Local design tooling only. Keep the real read-only value in
# .env.figma.local or the shell, never in application or GitHub environments.
# FIGMA_TOKEN=

# Forbidden in every environment and bundle:
# CRAVE_API_KEY / NEXT_PUBLIC_CRAVEUP_API_KEY
# cart capability / customer JWT / receipt token / checkout handoff token
