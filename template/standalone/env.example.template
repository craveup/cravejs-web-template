# Public standalone storefront configuration. The future CLI replaces the project identity and
# release/schema examples. After generation, change only documented merchant and deployment values
# before live use. These settings are not working credentials.

# Shared public Storefront API origin. It must exactly match apiBaseUrl in the JSON config; the SDK
# adds /api/v1/storefront.
NEXT_PUBLIC_CRAVEUP_API_URL=http://localhost:4708

# Standalone projects use one immutable generated config and never read a hosted tenant registry.
STOREFRONT_PROFILE=standalone-cli
STOREFRONT_STANDALONE_CONFIG_JSON={"profile":"standalone-cli","tenantId":"standalone:123e4567-e89b-42d3-a456-426614174000","projectId":"123e4567-e89b-42d3-a456-426614174000","merchantSlug":"replace-me","canonicalOrigin":"http://localhost:3000","apiBaseUrl":"http://localhost:4708","assetOrigins":[],"checkoutOrigins":["https://checkout.example.invalid"],"themeId":"base","locale":"en-US","timeZone":"America/Los_Angeles","templateRelease":"0.1.0","configSchemaVersion":"1.0.0","capabilities":{"loyalty":false},"newsletter":{"heading":"Stay in the loop","emailLabel":"Email address","submitLabel":"Subscribe","consentCopy":"Get restaurant news and offers in your inbox.","successMessage":"Thanks for subscribing."}}

# Optional delivery address browser integration. Restrict this public browser key by exact domain
# and only the Google Maps APIs used by the storefront.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-domain-restricted-browser-key

# Optional positive storefront delivery-radius policy; defaults to 5 miles.
# STOREFRONT_DELIVERY_RADIUS_MILES=5

# Never add Crave API keys, customer sessions, cart/receipt capabilities, opaque checkout handoff
# values, idempotency values, or provider secrets.
