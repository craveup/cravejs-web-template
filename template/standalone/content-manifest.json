      "ownership": "template-owned"
    },
    {
      "source": "template/standalone/README.template.md",
      "destination": "README.md",
      "ownership": "template-owned"
    },
    {
      "source": "template/standalone/UPGRADING.md",
      "destination": "docs/UPGRADING.md",
      "ownership": "template-owned"
    },
    {
      "source": "template/standalone/env.example.template",
